# Porta do servidor
PORT=3000
# URL pública deste serviço (usada nos links de mídia e webhooks)
PUBLIC_URL=http://localhost:3000

# Segredo para assinar tokens do painel embutido (troque em produção!)
APP_SECRET=troque-este-segredo
# Chave da plataforma iFlores (usada pelo backend da iFlores para criar lojas/tenants)
IFLORES_PLATFORM_KEY=troque-esta-chave-da-plataforma

# IA (Claude). Sem chave o sistema roda em MODO DEMONSTRAÇÃO (respostas simuladas)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Verify token do webhook do WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=iflores-verify

# Intervalo do agendador em segundos
SCHEDULER_INTERVAL=60
